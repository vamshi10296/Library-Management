<%- include('../partials/head', { pageTitle: 'Borrow Records & Circulation Audit - Admin Panel' }) %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="container">
    <%- include('../partials/flash-message') %>

    <div class="dashboard-layout">
      <!-- Admin Sidebar Navigation -->
      <%- include('../partials/sidebar') %>

      <!-- Main Borrow Records Table -->
      <div class="dashboard-main">
        <div class="dashboard-header">
          <div class="dashboard-title-group">
            <h1>Borrowing & Circulation Records</h1>
            <p class="dashboard-subtitle">Complete audit trail of book issues, returns, deadlines, and collected fines.</p>
          </div>
        </div>

        <!-- Filter Pill Tabs -->
        <div style="display: flex; gap: 0.65rem; margin-bottom: 1.75rem; flex-wrap: wrap;">
          <a href="/admin/borrow-records" class="btn btn-sm <%= activeFilter === 'all' ? 'btn-primary' : 'btn-secondary' %>">
            All Records
          </a>
          <a href="/admin/borrow-records?filter=issued" class="btn btn-sm <%= activeFilter === 'issued' ? 'btn-primary' : 'btn-secondary' %>">
            Currently Issued
          </a>
          <a href="/admin/borrow-records?filter=returned" class="btn btn-sm <%= activeFilter === 'returned' ? 'btn-primary' : 'btn-secondary' %>">
            Returned
          </a>
          <a href="/admin/borrow-records?filter=overdue" class="btn btn-sm <%= activeFilter === 'overdue' ? 'btn-danger' : 'btn-secondary' %>">
            ⚠️ Overdue
          </a>
        </div>

        <!-- Records Table -->
        <% if (records && records.length > 0) { %>
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Member</th>
                  <th>Book Title</th>
                  <th>Issue Date</th>
                  <th>Due Date</th>
                  <th>Return Date</th>
                  <th>Status</th>
                  <th>Fine</th>
                  <th style="text-align: right;">Action</th>
                </tr>
              </thead>
              <tbody>
                <% records.forEach(function(record) { %>
                  <tr>
                    <td>
                      <div style="font-weight: 700; color: var(--text-main);">
                        <%= record.user ? record.user.name : 'Unknown User' %>
                      </div>
                      <div style="font-size: 0.8rem; color: var(--text-muted);">
                        <%= record.user ? record.user.email : '' %>
                      </div>
                    </td>
                    <td>
                      <div style="font-weight: 600; color: #f8fafc;">
                        <%= record.book ? record.book.title : 'Book Not Found' %>
                      </div>
                      <div style="font-size: 0.8rem; color: var(--text-muted);">
                        ISBN: <%= record.book ? record.book.isbn : 'N/A' %>
                      </div>
                    </td>
                    <td><%= new Date(record.issueDate).toLocaleDateString('en-GB') %></td>
                    <td>
                      <%= new Date(record.dueDate).toLocaleDateString('en-GB') %>
                      <% if (record.status === 'Issued' && record.isOverdue) { %>
                        <div style="color: var(--danger); font-size: 0.75rem; font-weight: 700; margin-top: 2px;">
                          ⚠️ <%= record.overdueDays %>d late
                        </div>
                      <% } %>
                    </td>
                    <td>
                      <%= record.returnDate ? new Date(record.returnDate).toLocaleDateString('en-GB') : '—' %>
                    </td>
                    <td>
                      <% if (record.status === 'Returned') { %>
                        <span class="badge badge-success">Returned</span>
                      <% } else if (record.isOverdue) { %>
                        <span class="badge badge-danger">Overdue</span>
                      <% } else { %>
                        <span class="badge badge-info">Issued</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (record.liveFine > 0) { %>
                        <span style="color: var(--danger); font-weight: 700;">₹<%= record.liveFine %></span>
                      <% } else { %>
                        <span style="color: var(--success); font-weight: 500;">₹0</span>
                      <% } %>
                    </td>
                    <td style="text-align: right;">
                      <% if (record.status === 'Issued') { %>
                        <form action="/borrow/<%= record._id %>/return" method="POST" onsubmit="return confirmAction('Process return for this book on behalf of member?');" style="display: inline;">
                          <button type="submit" class="btn btn-secondary btn-sm" title="Mark as returned">
                            Process Return
                          </button>
                        </form>
                      <% } else { %>
                        <span style="color: var(--text-muted); font-size: 0.8rem;">Closed</span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">
            <div class="empty-state-icon">📋</div>
            <h3 class="empty-state-title">No Borrow Records Found</h3>
            <p class="empty-state-desc">There are no records matching the selected filter "<%= activeFilter %>".</p>
            <a href="/admin/borrow-records" class="btn btn-secondary">View All Records</a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
