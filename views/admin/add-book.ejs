<%- include('../partials/head', { pageTitle: 'Add New Book - Admin Panel' }) %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="container">
    <%- include('../partials/flash-message') %>

    <div class="dashboard-layout">
      <!-- Admin Sidebar Navigation -->
      <%- include('../partials/sidebar') %>

      <!-- Main Form Container -->
      <div class="dashboard-main">
        <div style="margin-bottom: 1.5rem;">
          <a href="/admin/books" class="btn btn-secondary btn-sm">&larr; Back to Books Inventory</a>
        </div>

        <div class="card" style="max-width: 680px; margin: 0 auto;">
          <div class="card-header">
            <h2>➕ Add New Book to Catalogue</h2>
          </div>

          <% if (errors && errors.length > 0) { %>
            <div class="alert alert-error">
              <ul style="list-style: none; padding: 0; margin: 0;">
                <% errors.forEach(function(err) { %>
                  <li>• <%= err.msg %></li>
                <% }); %>
              </ul>
            </div>
          <% } %>

          <form action="/admin/books/add" method="POST" class="auth-form" novalidate>
            <div class="form-group">
              <label for="title" class="form-label">Book Title *</label>
              <input 
                type="text" 
                id="title" 
                name="title" 
                class="form-control <%= errors && errors.some(e => e.path === 'title') ? 'input-error' : '' %>" 
                placeholder="e.g. Artificial Intelligence: A Modern Approach" 
                value="<%= typeof oldInput !== 'undefined' && oldInput.title ? oldInput.title : '' %>" 
                required
              >
            </div>

            <div class="form-group">
              <label for="author" class="form-label">Author(s) *</label>
              <input 
                type="text" 
                id="author" 
                name="author" 
                class="form-control <%= errors && errors.some(e => e.path === 'author') ? 'input-error' : '' %>" 
                placeholder="e.g. Stuart Russell, Peter Norvig" 
                value="<%= typeof oldInput !== 'undefined' && oldInput.author ? oldInput.author : '' %>" 
                required
              >
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
              <div class="form-group">
                <label for="isbn" class="form-label">ISBN Identifier *</label>
                <input 
                  type="text" 
                  id="isbn" 
                  name="isbn" 
                  class="form-control <%= errors && errors.some(e => e.path === 'isbn') ? 'input-error' : '' %>" 
                  placeholder="e.g. 978-0136042594" 
                  value="<%= typeof oldInput !== 'undefined' && oldInput.isbn ? oldInput.isbn : '' %>" 
                  required
                >
              </div>

              <div class="form-group">
                <label for="category" class="form-label">Category / Subject *</label>
                <input 
                  type="text" 
                  id="category" 
                  name="category" 
                  class="form-control <%= errors && errors.some(e => e.path === 'category') ? 'input-error' : '' %>" 
                  placeholder="e.g. AI & Machine Learning" 
                  value="<%= typeof oldInput !== 'undefined' && oldInput.category ? oldInput.category : '' %>" 
                  required
                >
              </div>
            </div>

            <div class="form-group">
              <label for="totalCopies" class="form-label">Total Initial Copies *</label>
              <input 
                type="number" 
                id="totalCopies" 
                name="totalCopies" 
                min="1" 
                class="form-control <%= errors && errors.some(e => e.path === 'totalCopies') ? 'input-error' : '' %>" 
                placeholder="e.g. 5" 
                value="<%= typeof oldInput !== 'undefined' && oldInput.totalCopies ? oldInput.totalCopies : '3' %>" 
                required
              >
              <small style="color: var(--text-muted); font-size: 0.8rem; margin-top: 4px; display: block;">
                Available copies will be automatically set equal to total copies upon creation.
              </small>
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 1rem;">
              <button type="submit" class="btn btn-primary" style="flex: 1;">
                <span>💾</span> Save & Catalogue Book
              </button>
              <a href="/admin/books" class="btn btn-secondary">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
