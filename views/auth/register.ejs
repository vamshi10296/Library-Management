<%- include('../partials/head', { pageTitle: 'Register - Library Management System' }) %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="container auth-wrapper">
    <div class="auth-card">
      <div class="auth-header">
        <div class="auth-icon">📝</div>
        <h1>Create an Account</h1>
        <p>Join the digital library to borrow books and access catalogues</p>
      </div>

      <%- include('../partials/flash-message') %>

      <% if (errors && errors.length > 0) { %>
        <div class="alert alert-error">
          <ul style="list-style: none; padding: 0; margin: 0;">
            <% errors.forEach(function(err) { %>
              <li>• <%= err.msg %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <form action="/register" method="POST" class="auth-form" novalidate>
        <div class="form-group">
          <label for="name" class="form-label">Full Name</label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            class="form-control <%= errors && errors.some(e => e.path === 'name') ? 'input-error' : '' %>" 
            placeholder="e.g. John Doe" 
            value="<%= typeof oldInput !== 'undefined' && oldInput.name ? oldInput.name : '' %>" 
            required 
            autocomplete="name"
          >
        </div>

        <div class="form-group">
          <label for="email" class="form-label">Email Address</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            class="form-control <%= errors && errors.some(e => e.path === 'email') ? 'input-error' : '' %>" 
            placeholder="e.g. member@example.com" 
            value="<%= typeof oldInput !== 'undefined' && oldInput.email ? oldInput.email : '' %>" 
            required 
            autocomplete="email"
          >
        </div>

        <div class="form-group">
          <label for="password" class="form-label">Password (Min. 6 characters)</label>
          <div class="password-input-wrapper">
            <input 
              type="password" 
              id="password" 
              name="password" 
              class="form-control <%= errors && errors.some(e => e.path === 'password') ? 'input-error' : '' %>" 
              placeholder="Create a secure password" 
              required 
              autocomplete="new-password"
            >
            <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('password', this)" title="Show/Hide password" aria-label="Toggle password visibility">
              👁️
            </button>
          </div>
        </div>

        <div class="form-group">
          <label for="confirmPassword" class="form-label">Confirm Password</label>
          <div class="password-input-wrapper">
            <input 
              type="password" 
              id="confirmPassword" 
              name="confirmPassword" 
              class="form-control <%= errors && errors.some(e => e.path === 'confirmPassword') ? 'input-error' : '' %>" 
              placeholder="Re-enter your password" 
              required 
              autocomplete="new-password"
            >
            <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('confirmPassword', this)" title="Show/Hide password" aria-label="Toggle password visibility">
              👁️
            </button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block" style="padding: 0.85rem; font-size: 1rem; margin-top: 0.5rem;">
          <span>✨</span> Register Account
        </button>
      </form>

      <div class="auth-footer">
        Already have an account? <a href="/login">Sign in here</a>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
