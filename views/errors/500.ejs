<%- include('../partials/head', { pageTitle: '500 - Internal Server Error' }) %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="container" style="display: flex; align-items: center; justify-content: center; min-height: 60vh;">
    <div class="card" style="max-width: 540px; text-align: center; padding: 3rem 2rem;">
      <div style="font-size: 4rem; color: var(--danger); line-height: 1; margin-bottom: 1rem; font-weight: 800;">500</div>
      <h1 style="font-size: 1.75rem; margin-bottom: 0.75rem;">Internal Server Error</h1>
      <p style="color: var(--text-muted); font-size: 1rem; margin-bottom: 2rem;">
        <%= typeof message !== 'undefined' ? message : 'Something went wrong on our servers while processing your request.' %>
      </p>
      <div style="display: flex; gap: 1rem; justify-content: center;">
        <a href="/" class="btn btn-primary">Return Home</a>
        <a href="/dashboard" class="btn btn-secondary">Go to Dashboard</a>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
